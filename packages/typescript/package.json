{
  "name": "@codaminds/identifiers",
  "version": "0.2.0",
  "engines": {
    "node": ">=20.12.0"
  },
  "description": "Open-source multi-language library for validating national identifiers with a common specification.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "format": "biome format --write src tests",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Codaminds/identifiers.git",
    "directory": "packages/typescript"
  },
  "bugs": {
    "url": "https://github.com/Codaminds/identifiers/issues"
  },
  "homepage": "https://github.com/Codaminds/identifiers#readme",
  "keywords": [
    "identifiers",
    "validation",
    "php",
    "typescript",
    "open-source",
    "multi-language"
  ],
  "author": "codediaz <codediaz@outlook.es>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^20.17.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}