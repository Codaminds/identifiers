{
  "name": "codaminds/identifiers",
  "description": "Open-source multi-language library for validating national identifiers with a common specification.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "codediaz",
      "email": "codediaz@outlook.es"
    }
  ],
  "require": {
    "php": "^8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0 || ^11.0",
    "laravel/pint": "^1.30"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "lint": "vendor/bin/pint --test",
    "format": "vendor/bin/pint"
  },
  "autoload": {
    "psr-4": {
      "Codaminds\\Identifiers\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Codaminds\\Identifiers\\Tests\\": "tests/"
    }
  }
}
